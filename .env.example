# Compose configuration — copy to .env. Local/demo values only; rotate before any non-local use.
POSTGRES_USER=daybook
POSTGRES_PASSWORD=daybook
POSTGRES_DB=daybook
JWT_SECRET=change-me-to-a-long-random-string
GEMINI_API_KEY=
MINIO_ROOT_USER=daybook
MINIO_ROOT_PASSWORD=daybook-minio
MINIO_BUCKET=daybook-attachments
MINIO_REGION=us-east-1
# Set these when the browser reaches MinIO through a different host/port.
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000

# AI agent (free-tier Gemini by default; auto falls back to the deterministic stub without a key)
REDIS_URL=redis://redis:6379
AI_PROVIDER=auto
AGENT_DEFAULT_MODEL=flash
AGENT_QUEUE_DRIVER=bull
AGENT_MAX_ATTEMPTS=3
AGENT_MODEL_FLASH=gemini-3.1-flash-lite
AGENT_MODEL_FLASH_LITE=gemini-3.1-flash-lite
AGENT_MODEL_PRO=gemini-3.1-pro-preview
# Set to 1 only for the guarded retry test hook.
AGENT_TEST_HOOKS=
