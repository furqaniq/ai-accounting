generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  ACCOUNTANT
  STAFF
  VIEWER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model Organization {
  id                     String                  @id @default(cuid())
  name                   String
  fiscalYearStartMonth   Int                     @default(1)
  fiscalYearStartDay     Int                     @default(1)
  baseCurrency           String                  @default("USD")
  defaultTaxRate         Decimal                 @default(0) @db.Decimal(5, 4)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  memberships            OrgMembership[]
  auditLog               AuditLogEntry[]
  accounts               Account[]
  journalEntries         JournalEntry[]
  customers              Customer[]
  vendors                Vendor[]
  items                  Item[]
  invoices               Invoice[]
  estimates              Estimate[]
  payments               Payment[]
  billPayments           BillPayment[]
  bills                  Bill[]
  expenses               Expense[]
  attachments            Attachment[]
  bankAccounts           BankAccount[]
  bankImportBatches      BankImportBatch[]
  bankTransactions       BankTransaction[]
  categorizationRules    CategorizationRule[]
  reconciliationSessions ReconciliationSession[]
}

model Account {
  id                      String               @id @default(cuid())
  organizationId          String
  code                    String
  name                    String
  type                    AccountType
  subtype                 String?
  active                  Boolean              @default(true)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  organization            Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalLines            JournalLine[]
  items                   Item[]
  invoiceLines            InvoiceLine[]
  estimateLines           EstimateLine[]
  billLines               BillLine[]
  expenses                Expense[]
  bankAccounts            BankAccount[]
  categorizationRules     CategorizationRule[] @relation("CategorizationRuleTarget")
  categorizedTransactions BankTransaction[]    @relation("BankTransactionCategory")

  @@unique([organizationId, code])
  @@index([organizationId, type])
}

enum JournalSourceType {
  MANUAL
  INVOICE
  BILL
  EXPENSE
  PAYMENT
  BANK
  REVERSAL
}

model JournalEntry {
  id             String            @id @default(cuid())
  organizationId String
  reference      String
  date           DateTime          @db.Date
  memo           String?
  sourceType     JournalSourceType @default(MANUAL)
  sourceId       String?
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines          JournalLine[]
  reversalOfId   String?           @unique
  reversalOf     JournalEntry?     @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy     JournalEntry?     @relation("JournalReversal")

  @@unique([organizationId, reference])
  @@unique([organizationId, sourceType, sourceId])
  @@index([organizationId, date])
  @@index([organizationId, sourceType, sourceId])
}

model JournalLine {
  id             String       @id @default(cuid())
  organizationId String
  entryId        String
  accountId      String
  description    String?
  debit          Decimal      @default(0) @db.Decimal(14, 2)
  credit         Decimal      @default(0) @db.Decimal(14, 2)
  createdAt      DateTime     @default(now())
  entry          JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id])

  @@index([organizationId, accountId])
  @@index([entryId])
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  code           String
  name           String
  contactName    String?
  email          String?
  phone          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  region         String?
  postalCode     String?
  country        String?
  notes          String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices       Invoice[]
  estimates      Estimate[]
  payments       Payment[]

  @@unique([organizationId, code])
  @@index([organizationId, name])
}

model Vendor {
  id             String        @id @default(cuid())
  organizationId String
  code           String
  name           String
  contactName    String?
  email          String?
  phone          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  region         String?
  postalCode     String?
  country        String?
  notes          String?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bills          Bill[]
  billPayments   BillPayment[]
  expenses       Expense[]

  @@unique([organizationId, code])
  @@index([organizationId, name])
}

enum BillStatus {
  DRAFT
  OPEN
  PARTIAL
  PAID
}

model Bill {
  id                  String                   @id @default(cuid())
  organizationId      String
  number              String
  vendorId            String
  status              BillStatus               @default(DRAFT)
  issueDate           DateTime                 @db.Date
  dueDate             DateTime                 @db.Date
  openedAt            DateTime?
  paidAt              DateTime?
  taxRate             Decimal                  @default(0) @db.Decimal(5, 4)
  subtotal            Decimal                  @default(0) @db.Decimal(14, 2)
  taxTotal            Decimal                  @default(0) @db.Decimal(14, 2)
  total               Decimal                  @default(0) @db.Decimal(14, 2)
  amountPaid          Decimal                  @default(0) @db.Decimal(14, 2)
  notes               String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor              Vendor                   @relation(fields: [vendorId], references: [id])
  lines               BillLine[]
  paymentApplications BillPaymentApplication[]

  @@unique([organizationId, number])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, vendorId])
}

model BillLine {
  id               String  @id @default(cuid())
  organizationId   String
  billId           String
  position         Int
  description      String
  quantity         Decimal @db.Decimal(14, 2)
  unitPrice        Decimal @db.Decimal(14, 2)
  amount           Decimal @db.Decimal(14, 2)
  expenseAccountId String
  bill             Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  expenseAccount   Account @relation(fields: [expenseAccountId], references: [id])

  @@index([organizationId, billId])
  @@index([organizationId, expenseAccountId])
}

model BillPayment {
  id             String                   @id @default(cuid())
  organizationId String
  number         String
  vendorId       String
  date           DateTime                 @db.Date
  amount         Decimal                  @db.Decimal(14, 2)
  method         PaymentMethod            @default(BANK_TRANSFER)
  reference      String?
  notes          String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor         Vendor                   @relation(fields: [vendorId], references: [id])
  applications   BillPaymentApplication[]

  @@unique([organizationId, number])
  @@index([organizationId, date])
  @@index([organizationId, vendorId])
}

model BillPaymentApplication {
  id             String      @id @default(cuid())
  organizationId String
  billPaymentId  String
  billId         String
  amount         Decimal     @db.Decimal(14, 2)
  createdAt      DateTime    @default(now())
  billPayment    BillPayment @relation(fields: [billPaymentId], references: [id], onDelete: Cascade)
  bill           Bill        @relation(fields: [billId], references: [id])

  @@unique([billPaymentId, billId])
  @@index([organizationId, billPaymentId])
  @@index([organizationId, billId])
}

model Expense {
  id                String       @id @default(cuid())
  organizationId    String
  number            String
  date              DateTime     @db.Date
  vendorId          String?
  categoryAccountId String
  amount            Decimal      @db.Decimal(14, 2)
  memo              String?
  receiptNote       String?
  version           Int          @default(1)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor            Vendor?      @relation(fields: [vendorId], references: [id])
  categoryAccount   Account      @relation(fields: [categoryAccountId], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId, date])
  @@index([organizationId, vendorId])
  @@index([organizationId, categoryAccountId])
}

enum AttachmentEntityType {
  EXPENSE
  BILL
}

model Attachment {
  id             String               @id @default(cuid())
  organizationId String
  entityType     AttachmentEntityType
  entityId       String
  objectKey      String               @unique
  filename       String
  contentType    String
  size           Int
  createdAt      DateTime             @default(now())
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType, entityId, createdAt])
}

enum BankAccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
}

enum BankImportFormat {
  CSV
  OFX
}

enum BankTransactionMatchState {
  UNMATCHED
  MATCHED
  CATEGORIZED
}

enum ReconciliationStatus {
  ACTIVE
  COMPLETED
}

model CategorizationRule {
  id                  String            @id @default(cuid())
  organizationId      String
  descriptionContains String
  targetAccountId     String
  priority            Int               @default(100)
  active              Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targetAccount       Account           @relation("CategorizationRuleTarget", fields: [targetAccountId], references: [id])
  bankTransactions    BankTransaction[]

  @@index([organizationId, active, priority])
  @@index([organizationId, targetAccountId])
}

model BankAccount {
  id                     String                  @id @default(cuid())
  organizationId         String
  name                   String
  type                   BankAccountType
  ledgerAccountId        String
  active                 Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledgerAccount          Account                 @relation(fields: [ledgerAccountId], references: [id])
  importBatches          BankImportBatch[]
  transactions           BankTransaction[]
  reconciliationSessions ReconciliationSession[]

  @@unique([organizationId, ledgerAccountId])
  @@index([organizationId, active])
}

model BankImportBatch {
  id             String            @id @default(cuid())
  organizationId String
  bankAccountId  String
  filename       String
  format         BankImportFormat
  rowCount       Int
  importedCount  Int               @default(0)
  duplicateCount Int               @default(0)
  invalidCount   Int               @default(0)
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount    BankAccount       @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  transactions   BankTransaction[]

  @@index([organizationId, bankAccountId, createdAt])
}

model BankTransaction {
  id                      String                    @id @default(cuid())
  organizationId          String
  bankAccountId           String
  importBatchId           String
  date                    DateTime                  @db.Date
  description             String
  amount                  Decimal                   @db.Decimal(14, 2)
  externalId              String?
  fingerprint             String
  matchState              BankTransactionMatchState @default(UNMATCHED)
  categoryAccountId       String?
  categoryRuleId          String?
  matchedEntityType       String?
  matchedEntityId         String?
  resolutionLabel         String?
  resolvedAt              DateTime?
  reconciliationSessionId String?
  clearedAt               DateTime?
  raw                     Json?
  createdAt               DateTime                  @default(now())
  organization            Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount             BankAccount               @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  importBatch             BankImportBatch           @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  categoryAccount         Account?                  @relation("BankTransactionCategory", fields: [categoryAccountId], references: [id], onDelete: SetNull)
  categoryRule            CategorizationRule?       @relation(fields: [categoryRuleId], references: [id], onDelete: SetNull)
  reconciliationSession   ReconciliationSession?    @relation("ReconciliationTransaction", fields: [reconciliationSessionId], references: [id], onDelete: SetNull)

  @@unique([organizationId, bankAccountId, fingerprint])
  @@index([organizationId, bankAccountId, date])
  @@index([organizationId, matchState])
  @@index([organizationId, categoryRuleId])
  @@index([organizationId, matchedEntityType, matchedEntityId])
  @@index([organizationId, reconciliationSessionId])
}

model ReconciliationSession {
  id                     String               @id @default(cuid())
  organizationId         String
  bankAccountId          String
  periodStart            DateTime             @db.Date
  periodEnd              DateTime             @db.Date
  statementEndingBalance Decimal              @db.Decimal(14, 2)
  openingBalance         Decimal              @default(0) @db.Decimal(14, 2)
  clearedTotal           Decimal              @default(0) @db.Decimal(14, 2)
  bookBalance            Decimal              @default(0) @db.Decimal(14, 2)
  difference             Decimal              @default(0) @db.Decimal(14, 2)
  status                 ReconciliationStatus @default(ACTIVE)
  completedAt            DateTime?
  completedById          String?
  completionSnapshot     Json?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount            BankAccount          @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  transactions           BankTransaction[]    @relation("ReconciliationTransaction")

  @@unique([organizationId, bankAccountId, periodStart, periodEnd])
  @@index([organizationId, bankAccountId, status])
  @@index([organizationId, periodEnd])
}

model Item {
  id              String         @id @default(cuid())
  organizationId  String
  code            String
  name            String
  description     String?
  price           Decimal        @default(0) @db.Decimal(14, 2)
  incomeAccountId String
  taxable         Boolean        @default(true)
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incomeAccount   Account        @relation(fields: [incomeAccountId], references: [id])
  invoiceLines    InvoiceLine[]
  estimateLines   EstimateLine[]

  @@unique([organizationId, code])
  @@index([organizationId, name])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
}

model Invoice {
  id                  String               @id @default(cuid())
  organizationId      String
  number              String
  customerId          String
  status              InvoiceStatus        @default(DRAFT)
  issueDate           DateTime             @db.Date
  dueDate             DateTime             @db.Date
  sentAt              DateTime?
  paidAt              DateTime?
  taxRate             Decimal              @default(0) @db.Decimal(5, 4)
  subtotal            Decimal              @default(0) @db.Decimal(14, 2)
  taxTotal            Decimal              @default(0) @db.Decimal(14, 2)
  total               Decimal              @default(0) @db.Decimal(14, 2)
  amountPaid          Decimal              @default(0) @db.Decimal(14, 2)
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer            Customer             @relation(fields: [customerId], references: [id])
  lines               InvoiceLine[]
  sourceEstimate      Estimate?
  paymentApplications PaymentApplication[]

  @@unique([organizationId, number])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, customerId])
}

model InvoiceLine {
  id              String  @id @default(cuid())
  organizationId  String
  invoiceId       String
  position        Int
  itemId          String
  description     String
  quantity        Decimal @db.Decimal(14, 2)
  unitPrice       Decimal @db.Decimal(14, 2)
  amount          Decimal @db.Decimal(14, 2)
  taxable         Boolean @default(true)
  incomeAccountId String
  invoice         Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item            Item    @relation(fields: [itemId], references: [id])
  incomeAccount   Account @relation(fields: [incomeAccountId], references: [id])

  @@index([organizationId, invoiceId])
  @@index([organizationId, itemId])
}

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

model Estimate {
  id                 String         @id @default(cuid())
  organizationId     String
  number             String
  customerId         String
  status             EstimateStatus @default(DRAFT)
  issueDate          DateTime       @db.Date
  expiryDate         DateTime?      @db.Date
  taxRate            Decimal        @default(0) @db.Decimal(5, 4)
  subtotal           Decimal        @default(0) @db.Decimal(14, 2)
  taxTotal           Decimal        @default(0) @db.Decimal(14, 2)
  total              Decimal        @default(0) @db.Decimal(14, 2)
  notes              String?
  convertedInvoiceId String?        @unique
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer       @relation(fields: [customerId], references: [id])
  lines              EstimateLine[]
  convertedInvoice   Invoice?       @relation(fields: [convertedInvoiceId], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId, status, issueDate])
  @@index([organizationId, customerId])
}

model EstimateLine {
  id              String   @id @default(cuid())
  organizationId  String
  estimateId      String
  position        Int
  itemId          String
  description     String
  quantity        Decimal  @db.Decimal(14, 2)
  unitPrice       Decimal  @db.Decimal(14, 2)
  amount          Decimal  @db.Decimal(14, 2)
  taxable         Boolean  @default(true)
  incomeAccountId String
  estimate        Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  item            Item     @relation(fields: [itemId], references: [id])
  incomeAccount   Account  @relation(fields: [incomeAccountId], references: [id])

  @@index([organizationId, estimateId])
  @@index([organizationId, itemId])
}

enum PaymentDirection {
  RECEIVED
  SENT
}

enum PaymentMethod {
  CASH
  CHECK
  BANK_TRANSFER
  CARD
  OTHER
}

model Payment {
  id             String               @id @default(cuid())
  organizationId String
  number         String
  direction      PaymentDirection     @default(RECEIVED)
  customerId     String
  date           DateTime             @db.Date
  amount         Decimal              @db.Decimal(14, 2)
  method         PaymentMethod        @default(BANK_TRANSFER)
  reference      String?
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer             @relation(fields: [customerId], references: [id])
  applications   PaymentApplication[]

  @@unique([organizationId, number])
  @@index([organizationId, date])
  @@index([organizationId, customerId])
}

model PaymentApplication {
  id             String   @id @default(cuid())
  organizationId String
  paymentId      String
  invoiceId      String
  amount         Decimal  @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])

  @@unique([paymentId, invoiceId])
  @@index([organizationId, paymentId])
  @@index([organizationId, invoiceId])
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String
  passwordHash  String
  createdAt     DateTime        @default(now())
  memberships   OrgMembership[]
  refreshTokens RefreshToken[]
  auditLog      AuditLogEntry[]
}

model OrgMembership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLogEntry {
  id             String       @id @default(cuid())
  organizationId String
  actorUserId    String
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User         @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}
