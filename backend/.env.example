# Local backend development — copy to backend/.env. Not used by Docker Compose (which injects these itself).
DATABASE_URL=postgresql://daybook:daybook@localhost:5432/daybook
JWT_SECRET=change-me-to-a-long-random-string
PORT=3001
CORS_ORIGINS=http://localhost:3000

REDIS_URL=redis://localhost:6379
AI_PROVIDER=auto
AGENT_DEFAULT_MODEL=flash
AGENT_QUEUE_DRIVER=bull
AGENT_MAX_ATTEMPTS=3
